table 'KPI Cards'
	lineageTag: 220330d5-73dd-4941-9d63-4bbc6c1dc16e

	measure 'Total Customers' = DISTINCTCOUNT(customer_rfm_final[CustomerID])
		formatString: #,0
		lineageTag: 57fc2665-4625-475b-856e-53eae4efcf78

	measure 'Total Revenue' = sum(transactions_clean[Revenue])
		lineageTag: 220e1e16-8663-4281-b470-45a1514f999e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Orders' = DISTINCTCOUNT(transactions_clean[InvoiceNo])
		formatString: #,0
		lineageTag: ea1f8667-e4a5-433d-ab1a-078294297751

	measure 'Average Customer Revenue' = AVERAGE(customer_rfm_final[Monetary])
		formatString: #,0.00
		lineageTag: 6e192a41-684b-4295-81c4-4fb3624b90ad

	measure 'Average Recency' = AVERAGE(customer_rfm_final[Recency])
