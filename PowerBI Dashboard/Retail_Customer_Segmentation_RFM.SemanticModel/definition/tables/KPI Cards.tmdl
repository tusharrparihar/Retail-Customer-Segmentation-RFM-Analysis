	measure 'Average Monetary' = AVERAGE(customer_rfm_final[Monetary])
		lineageTag: 81c1bb50-7b22-42e7-83fa-33d02097cc89

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Champions = CALCULATE(DISTINCTCOUNT(customer_rfm_final[CustomerID]),customer_rfm_final[Segment] = "Champions")
		formatString: 0
		lineageTag: b8f407b1-66a7-45d0-aacf-c5899272f0b6

	measure 'Loyal Customers' = CALCULATE(DISTINCTCOUNT(customer_rfm_final[CustomerID]),customer_rfm_final[Segment] = "Loyal Customers")
		formatString: 0
		lineageTag: 3d55d7e0-d243-4b5e-936e-5361a6a75178

	measure 'Potential Loyalists' = CALCULATE(DISTINCTCOUNT(customer_rfm_final[CustomerID]),customer_rfm_final[Segment] = "Potential Loyalists")
		formatString: 0
		lineageTag: a6619af8-8a21-4034-85ef-fd261100ad0c

	measure 'At-Risk Customers' = CALCULATE(DISTINCTCOUNT(customer_rfm_final[CustomerID]),customer_rfm_final[Segment] = "At-Risk Customers")
		formatString: 0
		lineageTag: 209f5252-0d21-4555-b42c-4a2cf81888bb

	measure '% of Total Customers' =
			
			DIVIDE(
			    [Total Customers],
			    CALCULATE(
			        [Total Customers],
			        ALL(customer_rfm_final[Segment])
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 05201661-969d-40c0-b3d9-e211bc208c21

	measure '% of Total Revenue' =
			
			DIVIDE(
			    [Total Revenue],
			    CALCULATE(
			        [Total Revenue],
			        ALL(customer_rfm_final[Segment])
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4e14bfac-2944-44e5-aa7f-8f4a86c1eb72

	measure 'Lost Customers' =
			
			CALCULATE(
			    [Total Customers],
			    customer_rfm_final[Segment] = "Lost Customers"
			)
		formatString: 0
		lineageTag: b05a7645-e562-45df-bbc8-34707af49757

	measure 'At-Risk Revenue' =
			
